APP_NAME=TrustRide
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=trustride
DB_USERNAME=postgres
DB_PASSWORD=

# The first super admin, created by `php artisan db:seed`. Change both before seeding anywhere real.
ADMIN_EMAIL=admin@trustride.test
ADMIN_PASSWORD=change-me-now

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shown to riders in the app. E.164, e.g. +233241234567.
SUPPORT_PHONE=
SUPPORT_WHATSAPP=

# How messages are sent. "log" writes them to storage/logs/laravel.log. "null" means the channel is not set up.
# log writes texts to storage/logs/laravel.log. hubtel sends real SMS and needs the HUBTEL_SMS_ keys.
MESSAGING_SMS_DRIVER=log
MESSAGING_WHATSAPP_DRIVER=null
MESSAGING_PUSH_DRIVER=null

# Hubtel SMS. The "SMS API Keys" pair from the Hubtel dashboard. Not the payment keys.
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
HUBTEL_SMS_SENDER_ID=TrustRide

# Payments. fake moves no money: a payment succeeds by itself after a few seconds (a number ending 0000 fails).
# hubtel sends a real mobile money prompt. It only works from a server whose IP Hubtel has whitelisted.
PAYMENTS_DRIVER=fake
PAYMENTS_FAKE_SETTLE_SECONDS=5
HUBTEL_API_USERNAME=
HUBTEL_API_KEY=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
# Must be reachable from the internet. Empty means APP_URL/api/webhooks/hubtel/payment.
HUBTEL_CALLBACK_URL=

# The operator's phone that is texted when an incident is raised (someone writes "I don't feel safe",
# or staff mark a case as an incident). Empty means nobody is texted.
SUPPORT_ALERT_PHONE=

# Days a van's location history is kept before it is deleted. Not decided by the business yet.
TRIPS_LOCATION_HISTORY_DAYS=30

# Direct debit. Leave empty to build the callback from APP_URL.
HUBTEL_PREAPPROVAL_CALLBACK_URL=
# Automatic renewal: days before the end the money is taken, and failures in a row before it is switched off.
AUTO_RENEW_CHARGE_DAYS_BEFORE=1
AUTO_RENEW_MAX_FAILURES=3
