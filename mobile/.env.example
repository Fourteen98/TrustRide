# Where the Laravel backend is. No trailing slash.
#
#   Android emulator:        http://10.0.2.2:8000/api   (the default if this is not set)
#   iOS simulator or web:    http://localhost:8000/api
#   A real phone on Wi-Fi:   http://<your Mac's IP>:8000/api, and start the backend with
#                            php artisan serve --host=0.0.0.0
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Only for a store or development build for Android. A Google Maps Platform key with "Maps SDK for Android"
# switched on, restricted to the package com.aveo.app. Expo Go and the iPhone (Apple Maps) do not need it.
GOOGLE_MAPS_ANDROID_KEY=
